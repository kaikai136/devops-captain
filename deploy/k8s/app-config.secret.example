apiVersion: v1
kind: Secret
metadata:
  name: devops-tools-config
  namespace: middleware
type: Opaque
stringData:
  app.conf: |
    # 复制为 app.conf；文件值优先于环境变量。布尔值用 0/1，列表用逗号分隔。
    # 基础与站点
    # Replace this demo key before production deployment; keep it stable for encrypted credentials.
    DJANGO_SECRET_KEY=devops-tools-k8s-demo-key-change-before-production-2026
    DJANGO_DEBUG=0
    DJANGO_ALLOWED_HOSTS=*
    DJANGO_CSRF_TRUSTED_ORIGINS=https://ops.example.com
    DJANGO_LANGUAGE_CODE=zh-hans
    TZ=Asia/Shanghai
    DJANGO_USE_I18N=1
    DJANGO_USE_TZ=1

    # HTTPS/代理：仅在可信代理覆盖 X-Forwarded-Proto 时启用信任。
    # HTTPS 站点可开启 Secure Cookie；HTTP 本地测试保持 0。
    DJANGO_TRUST_PROXY_SSL_HEADER=1
    DJANGO_USE_X_FORWARDED_HOST=0
    DJANGO_SECURE_SSL_REDIRECT=0
    DJANGO_SECURE_HSTS_SECONDS=0
    DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
    DJANGO_SECURE_HSTS_PRELOAD=0

    # 登录会话与 CSRF。SameSite=None 适用于 HTTPS 跨站 Cookie，需配合 Secure。
    DJANGO_SESSION_COOKIE_SECURE=0
    DJANGO_SESSION_COOKIE_HTTPONLY=1
    DJANGO_SESSION_COOKIE_SAMESITE=Lax
    DJANGO_SESSION_COOKIE_DOMAIN=
    DJANGO_SESSION_COOKIE_AGE=1209600
    DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=0
    DJANGO_CSRF_COOKIE_SECURE=0
    DJANGO_CSRF_COOKIE_HTTPONLY=0
    DJANGO_CSRF_COOKIE_SAMESITE=Lax
    DJANGO_CSRF_COOKIE_DOMAIN=

    # 跨域：同源部署保持关闭；跨域登录需设置明确来源和允许凭据。
    DJANGO_CORS_ALLOW_ALL_ORIGINS=0
    DJANGO_CORS_ALLOWED_ORIGINS=
    DJANGO_CORS_ALLOW_CREDENTIALS=0

    # 数据库：sqlite/sqlite3 或 mysql；MySQL 为外部服务。
    DATABASE_ENGINE=sqlite
    DJANGO_DB_PATH=/data/db.sqlite3
    DATABASE_SQLITE_TIMEOUT=5
    DATABASE_HOST=mysql.example.internal
    DATABASE_PORT=3306
    DATABASE_NAME=devops_tools
    DATABASE_USER=devops_tools
    DATABASE_PASSWORD=
    DATABASE_CHARSET=utf8mb4
    DATABASE_CONNECT_TIMEOUT=10
    # ASGI 推荐保持连接复用为 0；健康检查仅在复用连接时有意义。
    DATABASE_CONN_MAX_AGE=0
    DATABASE_CONN_HEALTH_CHECKS=0
    REDIS_CONFIG_FILE=/etc/devops-tools/redis.conf

    # 静态文件、媒体和上传。URL 改动需同步 Nginx 路由。
    DJANGO_STATIC_URL=/static/
    DJANGO_STATIC_ROOT=/app/backend/staticfiles
    DJANGO_FRONTEND_DIST_DIR=/app/backend/frontend_dist
    DJANGO_MEDIA_URL=/media/
    DJANGO_MEDIA_ROOT=/data/media
    DJANGO_SERVE_MEDIA_FILES=1
    WHITENOISE_AUTOREFRESH=0
    WHITENOISE_USE_FINDERS=0
    # 单位为字节；文件内存阈值控制何时转临时文件，并非文件总大小限制。
    DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
    FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
    DATA_UPLOAD_MAX_NUMBER_FILES=1000
    DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
    # 留空使用系统临时目录；自定义目录需提前创建并可写。
    FILE_UPLOAD_TEMP_DIR=

    # RDP 与录像
    GUACD_HOST=127.0.0.1
    GUACD_PORT=4822
    RDP_RECORDING_ROOT=/data/recordings
    RDP_RECORDING_RETENTION_DAYS=30
    RDP_RECORDING_DEFAULT_ENABLED=0

    # 批量执行
    BULK_EXECUTION_MAX_TARGETS=500
    BULK_EXECUTION_FORKS=10
    BULK_EXECUTION_TIMEOUT_SECONDS=300
    BULK_EXECUTION_RUN_ASYNC=1

    # 数据库传输：文件必须位于 API/Worker 共用的持久化目录。
    DATABASE_TRANSFER_DIR=/data/database-transfer
    DATABASE_ASSET_SQLITE_ROOT=/data/database_assets
    DATABASE_TRANSFER_RETENTION_DAYS=7
    DATABASE_TRANSFER_CHUNK_BYTES=8388608
    DATABASE_TRANSFER_BATCH_ROWS=500
    DATABASE_TRANSFER_TASK_TIMEOUT_SECONDS=86400
    DATABASE_TRANSFER_MIN_FREE_BYTES=2147483648
    # 以下 0 表示不设该项限制。
    DATABASE_TRANSFER_MAX_ROWS=0
    DATABASE_TRANSFER_MAX_TABLES=0
    DATABASE_TRANSFER_MAX_UPLOAD_BYTES=0
    DATABASE_TRANSFER_MAX_RESULT_BYTES=0
    DATABASE_TRANSFER_MAX_SQL_STATEMENT_BYTES=67108864

    # 缓存 TTL（秒）
    DASHBOARD_CACHE_SECONDS=30
    EGRESS_CACHE_SECONDS=300
    FEATURE_PERMISSION_CACHE_SECONDS=300
  redis.conf: |
    REDIS_URL=redis://devops-tools-redis:6379/3
